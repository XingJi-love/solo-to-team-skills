<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none';img-src data:;style-src 'unsafe-inline';script-src 'unsafe-inline';connect-src 'none';form-action 'none';base-uri 'none'"><title>第二轮，怎么变成了第二桌？ · A round or a table?</title><style>
*{box-sizing:border-box}html{--ink:#1c302b;--paper:#faf8f0;--rule:#afbbaf;--quiet:#435d53;--orange:#a0452b;background:var(--paper);color:var(--ink);font:16px/1.62 Inter,'PingFang SC',system-ui,sans-serif}body{margin:0}html:not([lang=en]) .en,html[lang=en] .zh{display:none!important}main{max-width:970px;padding:22px clamp(16px,5vw,65px) 55px;margin:auto}header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--rule);padding-bottom:12px;gap:12px}header a{font-weight:700;font-size:.88rem;color:inherit;text-decoration:none}.lang{background:transparent;border:1px solid var(--quiet);border-radius:4px;color:inherit;padding:.36rem .7rem;cursor:pointer}h1,h2,h3,p,figure{margin:0}h1{max-width:20em;font:600 clamp(37px,6vw,66px)/1.12 'Songti SC',Georgia,serif;letter-spacing:-.035em;margin:27px 0 11px}h2{font-size:1.32rem;line-height:1.35}h3{font-size:1.05rem;margin:2px 0}section{margin:26px 0}blockquote{border-left:4px solid var(--orange);padding:2px 0 2px 14px;margin:13px 0;font-size:1.05rem}figcaption{display:flex;gap:.5rem;align-items:baseline;color:var(--quiet);margin-bottom:6px;font-size:.9rem}figcaption b{color:var(--ink);font-family:ui-monospace,monospace}.strip{margin-top:12px}figure+figure{margin-top:12px}figure img{display:block;width:100%;height:auto;background:#132c28;border-radius:3px}small,.note{color:var(--quiet);font-size:.86rem}.flow{padding:0;margin:10px 0;list-style:none}.flow li{border-top:1px solid var(--rule);padding:10px 0}.flow p{margin:2px 0}.brief{font-size:1.06rem;color:var(--quiet);max-width:65ch}.hash{display:block;font: .88rem/1.6 ui-monospace,monospace;overflow-wrap:anywhere;user-select:all;margin:5px 0}.proof{border:1px solid var(--rule);border-radius:4px;padding:14px 17px}.proof summary{font-weight:700;cursor:pointer}.proof p{margin:9px 0}.actions{display:flex;flex-wrap:wrap;gap:9px}.actions a,.file{font:inherit;font-size:.92rem;line-height:1.35;display:inline-block;padding:8px 11px;border:1px solid var(--quiet);border-radius:3px;color:var(--ink);background:transparent;cursor:pointer;text-decoration:none}.file{position:relative;background:#173f36;color:white;overflow:hidden}.file input{position:absolute;inset:0;opacity:0;cursor:pointer}button:focus-visible,a:focus-visible,summary:focus-visible,.file:focus-within{outline:3px solid #a54c25;outline-offset:3px}#response{overflow-wrap:anywhere;font-weight:600}footer{border-top:1px solid var(--rule);padding-top:12px;color:var(--quiet);font-size:.86rem}@media(max-width:540px){figure{overflow-x:auto}figure img{width:max(100%,580px)}.strip{padding-bottom:4px}.proof{padding:12px}.lang{min-height:42px}}@media print{.lang,.actions,#response{display:none}main{padding:0}.proof{break-inside:avoid}}
</style></head><body><main id="top"><header><strong><span class="zh">一人成阵 · 实际交付案例</span><span class="en" lang="en">Solo to Team · Delivery case</span></strong><button type="button" id="switch" class="lang" aria-label="Switch to English">English</button></header><h1><span class="zh">第二轮，怎么变成了第二桌？</span><span class="en" lang="en">Round two became table two.</span></h1><p class="brief"><span class="zh">一份准备放到 GitHub 的项目展示，经过独审被退回。审核员在中英文文案、字幕和动图里，找到了同一个未经原表支持的桌号。</span><span class="en" lang="en">A reviewer sent a GitHub showcase draft back. The bilingual copy, captions and animations all named a table that the source worksheet never identified.</span></p><section><h2><span class="zh">现场原表写了什么</span><span class="en" lang="en">What the worksheet said</span></h2><blockquote><span class="zh">“绘图第二轮”　“只能动用 1 套备品”<br>交接单 C7　“1 套（未动用）／0 套（已动用，注明桌号与时间）”</span><span class="en" lang="en">“Mapping, round two” · “Only one spare kit may be used.”<br>Handoff row C7: “1 kit if unused / 0 if used. Record the table number and time.”</span></blockquote><p><span class="zh">这是合成活动的执行表。示范当然可以挑第二桌，但桌号须由现场填写。</span><span class="en" lang="en">The source is a practice-event worksheet; its instructions above are translated from Chinese. The demo could choose table two. At handoff, volunteers would record the actual table.</span></p></section><section class="strip"><h2><span class="zh">同一时刻，看两版动图</span><span class="en" lang="en">The same moment in both animations</span></h2><p class="note"><span class="zh">00:03.60 · 原动图字幕区原像素裁切。手机可左右滑动图片。</span><span class="en" lang="en">00:03.60 · Caption strips cropped from the original frames. On a phone, swipe a strip sideways.</span></p><figure><figcaption><b>R1</b><span class="zh">送审画面</span><span class="en" lang="en">Submitted</span></figcaption><img class="zh" alt="R1 动图字幕：第二桌领用后，初稿报少一套，修订版对上了。" width="960" height="100" src="data:image/png;base64,[[MAS:asset-1]]"><img class="en" alt="R1 animation: Table two uses the kit. Only the revised sheet reconciles." width="960" height="100" src="data:image/png;base64,[[MAS:asset-2]]"></figure><figure><figcaption><b>R2</b><span class="zh">修订画面</span><span class="en" lang="en">Revised</span></figcaption><img class="zh" alt="R2 动图字幕：桌号为演示设定。第二轮动用1套备品，修订后的应交数与实点数一致。" width="960" height="100" src="data:image/png;base64,[[MAS:asset-3]]"><img class="en" alt="R2 animation: Table number shown for illustration. Round two used one kit. The revised expected count reconciles." width="960" height="100" src="data:image/png;base64,[[MAS:asset-4]]"></figure></section><section><h2><span class="zh">这一单怎样交了回来</span><span class="en" lang="en">How the file made it back</span></h2><ol class="flow"><li><h3><span class="zh">制作人改回有依据的说法</span><span class="en" lang="en">The maker corrected the claim</span></h3><p><span class="zh">云端审核员对照工作表退修。据团队在工作窗口的实际观察，Codex 协调原制作方修正两种语言的首页、字幕、视频和动图。原审核员随后对修改处作了限定复核，批准这份队内修订版。</span><span class="en" lang="en">The local maker submitted the draft and a cloud reviewer returned it after checking the worksheet. The team observed Codex coordinating revisions to both languages across the landing pages, captions, videos and GIFs. The original reviewer checked those changes and approved R2 for internal use.</span></p></li><li><h3><span class="zh">首席只发了一次</span><span class="en" lang="en">The lead sent it once</span></h3><p><span class="zh">首席在约定的原窗口交回了审核过的 ZIP。发件记录在收件目标后面多写了括号说明，续办工具发现它与原约定不一致。首席核实发件位置，单独更正记录，沿用原件与独审。</span><span class="en" lang="en">The lead returned the reviewed ZIP in the agreed conversation. A parenthetical note in the dispatch record changed the destination label. The handoff checker flagged it. The sender checked the original destination and corrected the record. The ZIP was sent once and its review stood.</span></p></li><li><h3><span class="zh">接收方核对的是实物</span><span class="en" lang="en">The recipient checked the file itself</span></h3><p><span class="zh">据团队接收席实际观察，该席取得并打开 ZIP，重算文件指纹，核对附件与独审记录，再用更正后的发件记录登记实收。这一单由两端直接交接，委托人无需搬话。</span><span class="en" lang="en">The team’s receiving desk reports opening the ZIP, recomputing its fingerprint and checking it against the review. Its receipt references the corrected dispatch. The two workspaces exchanged the file directly; the requester did not relay messages.</span></p></li></ol></section><section aria-labelledby="record-title"><h2 id="record-title"><span class="zh">接收席留下的记录</span><span class="en" lang="en">The recipient’s record</span></h2><p><span class="zh">队内接收席出具了实收记录。摘录保留原记录的种类、出具席位、版次、产物指纹、所引交件指纹和实收结果。原消息位置与私人出处已省略。持有同版文件的读者可核对其字节；摘录本身无法供外部独立认证出具者身份或私有窗口中的收件动作。</span><span class="en" lang="en">The team’s receiving desk issued the receipt. The excerpt preserves the original record type, author role, version, artifact hash, referenced dispatch hash and result. Private source references and message locations are omitted. A reader with the file can check its bytes. The excerpt alone cannot independently authenticate the author or delivery in the private conversation.</span></p><p><a href="receipt-excerpt.json"><span class="zh">打开旁附摘录</span><span class="en" lang="en">Open the accompanying excerpt</span></a> · <a id="save-receipt" download="receipt-excerpt.json" href="data:application/json;base64,"><span class="zh">下载脱敏原字段 · JSON</span><span class="en" lang="en">Download the redacted original fields · JSON</span></a></p></section><details class="proof"><summary><span class="zh">自己核对原字幕或展示件</span><span class="en" lang="en">Verify a caption excerpt or the ZIP locally</span></summary><p><span class="zh">两份字幕摘录均取自各自展示 ZIP 内同一编号、同一时间段的双语 VTT。可下载其中一份，再选回来核对。手头已有任一版展示 ZIP，也可直接选择。文件只在本页读取。</span><span class="en" lang="en">The two WebVTT excerpts contain the same numbered cue and time interval from each showcase ZIP. Save one, then select it below. If you already have either original ZIP, you can check that too. Files are read locally.</span></p><div class="actions"><a id="down1" download="R1-caption-cue-3.txt"><span class="zh">取 R1 原字幕摘录</span><span class="en" lang="en">Save R1 source cue</span></a><a id="down2" download="R2-caption-cue-3.txt"><span class="zh">取 R2 原字幕摘录</span><span class="en" lang="en">Save R2 source cue</span></a><label class="file"><span class="zh">选择本地文件核对</span><span class="en" lang="en">Check a local file</span><input type="file" id="choose"></label></div><p id="response" role="status" aria-live="polite"></p><p><span class="zh">独审记录、发件记录、接收方实际文件共同对应的 R2 展示 ZIP</span><span class="en" lang="en">R2 showcase ZIP matched across the review, dispatch and received file</span> · 18,049,645 bytes <code class="hash">514e73780057c8aaa11cb371f6284f53c29aea7d251c62668d14d22ed284e7a1</code></p><small><span class="zh">本次展示件与项目产品包均按队内候审口径呈现。上述指纹只指向本次展示 ZIP。</span><span class="en" lang="en">The showcase and the product package are presented here for internal review. This fingerprint identifies only the showcase ZIP.</span></small></details><footer><span class="zh">本案例及摘录供队内候审。独审结论限本次展示件。过程中有 Codex 协调、退修与原席更正。案例记录一次具体应用，规则最早如何形成另无取证。</span><span class="en" lang="en">This case and its excerpts are under internal review. Approval covered this showcase only. Codex coordinated the return and the original seats made the corrections. These records document one use of the rule; its historical origin was outside the review.</span></footer></main><script>const source={"R1":{"size":16896197,"sha":"f43bf95a657a17a66f6b01138f22f2d54adab20d6d485d9965dd77add906bcd8","clip":"MwowMDowMDowNS4zNzUgLS0+IDAwOjAwOjA5LjkxNwpUYWJsZSB0d28gdGFrZXMgdGhlIGtpdC4gTm93IGNvbXBhcmUgdGhlIHR3byByZXN1bHRzLgrnrKzkuozmoYzmjInorqHliJLpoobnlKjlkI7vvIzliJ3nqL/mmL7npLrlsJHkuIDlpZfvvJvkv67orqLniYjorqHmlbDnm7jnrKbjgIIK","clipSize":165,"clipSha":"ce7b3da78cf44cba73e80710b3eab31bcde544837d5d6a226367d4dadb2c3197"},"R2":{"size":18049645,"sha":"514e73780057c8aaa11cb371f6284f53c29aea7d251c62668d14d22ed284e7a1","clip":"MwowMDowMDowNS4zNzUgLS0+IDAwOjAwOjA5LjkxNwpPbmUgc3BhcmUga2l0IHdhcyB1c2VkIGluIHJvdW5kIHR3by4gVGhlIHJlY2VpdmluZyB0YWJsZSBzaG93biBpcyBpbGx1c3RyYXRpdmUuCuWOn+iusOW9leWGmeaYjuesrOS6jOi9ruWKqOeUqCAxIOWll+Wkh+WTgeOAgueUu+mdouS4reeahOmihueUqOahjOWPt+S4uua8lOekuuiuvuWumuOAggo=","clipSize":200,"clipSha":"c49916cd5beb9f856a3c329f2493404b4c89dd0e3789ad36837547d69f3767ec"}};

let en=false,epoch=0,reading='',last=null;
const el=id=>document.getElementById(id);
function say(){
 const out=el('response');if(reading){out.textContent=en?'Checking the actual bytes…':'正在核对实际字节…';return}
 if(!last){out.textContent='';return}
 if(last.error){out.textContent=en?'Unable to compute SHA-256 here. Try a current browser.':'当前浏览器未能计算 SHA-256，请用支持本地核验的浏览器。';return}
 if(!last.match){out.textContent=en?'No match among the two original ZIPs or the two exact caption excerpts.':'与两版原 ZIP 及两份原字幕摘录均未匹配。';return}
 const [v,kind]=last.match;
 out.textContent=(en?'Matched ':'已匹配 ')+v+(en?(kind==='sha'?' showcase ZIP':' original caption excerpt'):(kind==='sha'?' 展示 ZIP':' 原字幕摘录'))+' · SHA-256 '+last.hash;
}
function applyLocale(){
 en=location.hash==='#en';
 document.documentElement.lang=en?'en':'zh-CN';
 el('switch').textContent=en?'中文':'English';
 el('switch').setAttribute('aria-label',en?'切换为中文':'Switch to English');
 say();
}
el('switch').onclick=()=>{location.hash=en?'zh':'en'};
addEventListener('hashchange',applyLocale);
applyLocale();
for(const [v,id] of [['R1','down1'],['R2','down2']]){el(id).href='data:text/plain;charset=utf-8;base64,'+source[v].clip}
el('choose').onchange=async e=>{
 const file=e.target.files[0],seq=++epoch;last=null;reading='';if(!file){say();return}
 const candidates=Object.entries(source).flatMap(([v,r])=>['sha','clipSha'].filter(k=>file.size===r[k==='sha'?'size':'clipSize']).map(k=>[v,k]));
 if(!candidates.length){last={match:null};say();return}
 reading='checking';say();
 try{const b=await crypto.subtle.digest('SHA-256',await file.arrayBuffer());if(seq!==epoch)return;const hash=Array.from(new Uint8Array(b),x=>x.toString(16).padStart(2,'0')).join('');last={hash,match:candidates.find(([v,k])=>source[v][k]===hash)};}
 catch{if(seq!==epoch)return;last={error:true}}
 reading='';say();
};
</script></body></html>