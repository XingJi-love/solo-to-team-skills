<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>一人成阵 · 项目交付</title><style>
:root{--ink:#172b27;--forest:#15392f;--leaf:#e2f2a9;--olive:#9cab8b;--paper:#fcfcf7;--rule:#c5cec1;--muted:#4c5f54;--hero:#12372e;color-scheme:light}
*{box-sizing:border-box}html{font:16px/1.55 Inter,-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;background:var(--paper);color:var(--ink)}body{margin:0}a{color:#104d3b;text-underline-offset:.2em;text-decoration-thickness:.08em}a:hover{text-decoration-thickness:.14em}a:focus-visible,video:focus-visible,summary:focus-visible{outline:3px solid #b86b05;outline-offset:3px}p,h1,h2,h3{margin:0}.inner{width:min(1200px,calc(100% - 76px));margin-inline:auto}.bar{background:#f5f7ec;border-bottom:1px solid var(--rule)}.bar .inner{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:13px 0}.logo{display:inline-flex;align-items:center;gap:9px;color:var(--forest);font-size:19px;font-weight:740;letter-spacing:-.035em}.sig{width:28px;height:24px;position:relative;display:inline-block}.sig i{position:absolute;left:0;width:14px;height:5px;background:var(--forest)}.sig i:first-child{top:1px}.sig i:nth-child(2){top:10px;left:7px}.sig i:last-child{top:19px;left:14px}.bar nav{display:flex;align-items:center;gap:22px}.bar nav a{font-size:.94rem;color:var(--forest)}.bar nav a:not(:last-child){text-decoration:none}.bar nav a:hover{text-decoration:underline}.switch{font-weight:630;white-space:nowrap}
.hero{background:var(--hero);color:#fafbf2}.hero .inner{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,1fr);gap:clamp(24px,4vw,64px);align-items:center;padding:clamp(44px,5.3vw,76px) 0}
h1,h2,.case-card h3{font-family:Georgia,"Songti SC",STSong,"Noto Serif CJK SC",serif;letter-spacing:-.035em;font-weight:590;text-wrap:balance}h1{font-size:clamp(40px,4.1vw,66px);line-height:1.14}.hero-copy>p{color:#e0e8db;font-size:clamp(17px,1.45vw,21px);line-height:1.6;margin-top:18px;max-width:630px}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:10px 15px;margin-top:22px}.primary,.ghost,.file{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:8px 15px;border-radius:3px;text-decoration:none;font-weight:680;line-height:1.35}.primary{background:var(--leaf);color:#1f3727}.ghost{border:1px solid #a3bcaa;color:#f4f8e9}.primary:hover{background:#f0ffc3}.ghost:hover{background:#204f40}.hero-copy .trialnote{font-size:.875rem;margin-top:9px;color:#d2dfca}.player{margin:0;min-width:0}.player video{display:block;width:100%;height:auto;aspect-ratio:16/9;background:#18251f;border:1px solid #8caa91}.player figcaption{display:flex;align-items:baseline;justify-content:space-between;gap:9px;flex-wrap:wrap;padding-top:8px;font-size:.88rem;color:#d9e7d4}.player figcaption a{color:#e5efd4}.medialinks{white-space:nowrap}
.strip{padding:32px 0 36px}.strip+.strip{border-top:1px solid var(--rule)}h2{font-size:clamp(29px,3.4vw,44px);line-height:1.18}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px}.section-head p,.fine{color:var(--muted)}.section-head p{margin-top:5px}.strip .textlink{font-weight:650}.hostlist{border-top:2px solid var(--forest);margin-top:22px}.host{display:grid;grid-template-columns:minmax(130px,.7fr) minmax(0,2fr) minmax(132px,.72fr);align-items:start;gap:20px;padding:17px 0;border-bottom:1px solid var(--rule)}.host>div{overflow-wrap:anywhere}.host h3{font-size:1.12rem;line-height:1.4;letter-spacing:-.015em}.host details{margin-top:5px}.host details p{margin:5px 0 0;color:var(--muted);font-size:.9rem}summary{cursor:pointer;font-size:.86rem;color:#3e5c4b;text-underline-offset:.16em}summary:hover{text-decoration:underline}.file{justify-self:end;background:#e8eee1;color:var(--forest);min-height:37px;font-size:.88rem}.file:hover{background:#dbe7d4}.ds{font-size:.92rem;max-width:900px;margin-top:13px;color:var(--muted)}.evidence{font-size:.85rem;color:var(--muted);margin-top:12px}
.field{background:#e8eee4}.field .inner{padding:34px 0}.steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;counter-reset:step;list-style:none;padding:0;margin:20px 0}.steps li{border-inline-start:2px solid #a7bc98;padding-inline-start:13px;counter-increment:step}.steps h3{font-size:1.04rem}.steps h3:before{content:counter(step) '. ';font-weight:560;color:#4e6946}.steps p{margin:4px 0 6px}.steps a{font-size:.9rem;font-weight:620}.distinction{border-top:1px solid #bbcbbb;padding-top:14px;font-size:.95rem}
.bottom{display:grid;grid-template-columns:1.15fr 1fr;gap:clamp(22px,5vw,76px);padding:34px 0}.case-card{border:1px solid #b0b8a7;border-left:5px solid #416d49;background:#f6f6ec;padding:19px 24px}.case-card h3{font-size:clamp(24px,2.7vw,35px);line-height:1.19}.case-card p{margin:10px 0}.case-card a{font-weight:660}.more h2{font-size:1.28rem;font-family:inherit;letter-spacing:0;font-weight:670}.more dl{margin:7px 0 0}.more dl>div{padding:6px 0;border-top:1px solid var(--rule)}.more dt,.more dd{margin:0}.more a{font-weight:630}.more dd{font-size:.88rem;color:var(--muted)}
footer{border-top:1px solid var(--rule);padding:13px 0 24px}.footrow{display:flex;justify-content:space-between;color:var(--muted);gap:10px;font-size:.88rem}
[hidden]{display:none!important}@media(max-width:850px){.inner{width:calc(100% - 36px)}.hero .inner{grid-template-columns:1fr;gap:22px;padding:33px 0}h1{font-size:clamp(38px,6.4vw,57px)}.hero-copy>p{max-width:700px}.player{max-width:720px}.host{grid-template-columns:minmax(118px,.7fr) minmax(0,2fr) minmax(100px,.7fr);gap:11px}.steps{gap:15px}}
@media(max-width:570px){.inner{width:calc(100% - 28px)}.bar .inner{padding:9px 0}.bar nav{gap:12px}.bar nav a{font-size:.85rem}.bar nav a:nth-child(2){display:none}.logo{font-size:17px}.hero .inner{padding:25px 0 17px}.hero-copy>p{margin-top:10px;font-size:16px}.actions{margin-top:14px}.player figcaption{font-size:.8rem;padding-top:5px}.primary,.ghost{min-height:40px;padding:7px 12px}.section-head{display:block}.section-head>a{display:inline-block;margin-top:8px;font-size:.9rem}.strip{padding:23px 0}.hostlist{margin-top:13px}.host{grid-template-columns:minmax(0,1fr) auto;gap:5px 9px;padding:11px 0}.host>div{grid-column:1/-1;grid-row:2}.host>.file{grid-column:2;grid-row:1}.host h3{align-self:center}.file{font-size:.81rem;min-height:35px;padding:5px 8px}.bottom,.steps{grid-template-columns:1fr;gap:17px}.bottom{padding:23px 0}.field .inner{padding:21px 0}.steps{margin:13px 0}.case-card{padding:14px}.evidence{font-size:.82rem}}
</style></head><body><div data-locale="zh" lang="zh-CN" id="zh"><header class="bar"><div class="inner"><span class="logo"><span class="sig" aria-hidden="true"><i></i><i></i><i></i></span>一人成阵</span><nav aria-label="页面导航"><a href="#hosts-zh">选择平台</a><a href="#real-zh">实际案例</a><a href="#en" lang="en" class="switch">English</a></nav></div></header><main><section class="hero"><div class="inner"><div class="hero-copy"><p class="scope-note" style="font-size:.85rem;margin:0 0 10px">队内候选 · 新增内容尚未分配公开许可</p><h1>半成品交给首席。<br>改了要求，再收成品。</h1><p>你只在首席的原对话提需求。制作席接手修改，另一席打开文件审核，首席把同一版成品和结论交回来。</p><div class="actions"><a href="learn/try-review.html" class="primary">我来验这一单</a><a href="builder/四端统一建队台.html" class="ghost">组建自己的团队</a></div><p class="trialnote">离线体验，无需账号或模型</p></div><figure class="player"><video controls playsinline preload="none" width="960" height="540" aria-label="一套备品，为什么要退修？" poster="data:image/webp;base64,[[MAS:asset-1]]"><source src="media/demo.zh-CN.mp4" type="video/mp4"></video><figcaption><span>一套备品，为什么要退修？</span><span class="medialinks"><a href="media/demo.zh-CN.mp4">25 秒演示</a> · <a href="media/demo.zh-CN.gif">动图版</a></span></figcaption></figure></div></section><section class="strip inner" id="hosts-zh"><div class="section-head"><div><h2>在我的平台跑首单</h2><p>选已有可用模型的平台，先用预设三席。</p></div><a href="builder/四端统一建队台.html" class="textlink">改用自己的岗位、群和头像</a></div><div class="hostlist"><section class="host"><h3>Grok Bot</h3><div><p>解压后复用已有席位，按岗位卡补齐缺席。</p><details><summary>查看此入口的验证范围</summary><p>现役团队曾按一次督导退修，复核后在首席原对话交回 R2。自配入口提供引导式建队；整队原生导入尚无实证。</p></details></div><a href="core/adapters/grok/first-order.zip" download class="file">打开首单包</a></section><section class="host"><h3>OpenMausBot</h3><div><p>在 OpenMausBot 0.1.148 选「模板 → 导入」，选择解压包内 core/adapters/openmaus/team.openmaus.json，预览时核对同名部门和权限。</p><details><summary>查看此入口的验证范围</summary><p>首单用手动建立的三席完成。自配四席经 0.1.148 原生数据层隔离导入；用户真实账号界面跑单尚待验证。重复添加会另建部门。</p></details></div><a href="core/adapters/openmaus/team.openmaus.json" class="file">查看部门文件</a></section><section class="host"><h3>WorkBuddy</h3><div><p>在「我的专家」准备项目交付团，选专用工作区，再把半成品交给主理人。</p><details><summary>查看此入口的验证范围</summary><p>0.1.0 原件的首单发生在已配置的私有三席。Mac 私有安装器适配 WorkBuddy 5.9.3，未经 Apple 公证。原件示例邮箱仅作占位。</p></details></div><a href="core/adapters/workbuddy/start.html" class="file">看安装入口</a></section><section class="host"><h3>DeepSeek Harness</h3><div><p>解压标准包，工作区选「一人成阵-DSH」目录本身，里面有 inputs 和隐藏的 .dsh。新会话选 /solo-to-team。</p><details><summary>查看此入口的验证范围</summary><p>标准包的变更卡在同级「试用者第二步」，等首席确认底稿再发。自配项目 ZIP 则直接解到新空目录，选择含 team.definition.json 的那一层。标准与自配四席均有已配置本机的实际任务留件。</p></details></div><a href="core/adapters/deepseek/project.zip" download class="file">取标准项目包</a></section></div><p class="ds">已有 DS Bot v0.3.2？在统一建队台选择 DeepSeek，再选 DS Bot，可导出长期席位的离线建队计划；实际建队仍需在自己的 Main Bot 核清并确认。 <a href="builder/四端统一建队台.html">打开统一建队台</a> 本计划按 DS Bot v0.3.2 公开源码整理，尚未在真实 DS Bot 里试走；实际结果以接收账号的 Main Bot 回查为准。</p><details class="evidence"><summary>实测范围</summary><p>首单记录来自本机观察与团队留件，未取得平台端运行日志。不同宿主和不同导出各自核收。新用户独立装队的成功率尚未测量。</p></details></section><section class="field"><div class="inner"><h2>交第一单</h2><ol class="steps"><li><h3>交半成品</h3><p>把 20 人活动底稿发给首席，请它先确认接到哪一版。</p><a href="core/brief/01-intake.md">取活动底稿</a></li><li><h3>中途改要求</h3><p>收到版本回执，再在同一会话给出 24 人变更。</p><a href="core/brief/02-change.md">取变更卡</a></li><li><h3>验同一版</h3><p>打开执行包和审核记录，对照版本、变更和实际交件。换会话时用已有断点接续。</p><a href="resume/从这里续办.html">打开续办工具</a></li></ol><p class="distinction">收件只说明文件到了。验收通过，需要审核席实际打开对应版本并给出结论。群里同步进度，派工和执行仍按原有授权。</p></div></section><div class="bottom inner" id="real-zh"><section class="case-card"><h3>“第二轮”怎么变成了“第二桌”？</h3><p>一份准备放上 GitHub 的展示稿，把原表中的轮次写成了桌号。跟着两版字幕、审核意见和实际收件，看这项错误如何在跨宿主交付中被纠正。</p><a href="proof/real-handoff/index.html">看这次真实交付</a> · <a href="proof/authority/index.html">谁有权改数量？</a></section><section class="more"><h2>接着用</h2><dl><div><dt><a href="core/examples/maintenance/01-intake.md">换一道题：社区维修预约</a></dt><dd>地点临时封闭，看看哪些预约和通知需要跟着改。</dd></div><div><dt><a href="core/skills-original/README.md">原来的四个 Skills</a></dt><dd>分别取用，也可配合团队工作。</dd></div><div><dt><a href="source/README.md">开发者源码</a></dt><dd>查看本候选包的源码与复现入口。</dd></div></dl></section></div><p class="inner"><a href="core/index.html">原核心首单入口</a> · <a href="core/README.md">核心说明</a> · <a href="builder/四端统一建队台.html">现行统一建队台</a></p></main><footer><div class="inner footrow"><span>一人成阵，合力成事</span><a href="README.md">文字版</a></div></footer></div><div data-locale="en" lang="en" id="en" hidden><header class="bar"><div class="inner"><span class="logo"><span class="sig" aria-hidden="true"><i></i><i></i><i></i></span>Solo to Team</span><nav aria-label="Page navigation"><a href="#hosts-en">Platforms</a><a href="#real-en">Real case</a><a href="#zh" lang="zh-CN" class="switch">中文</a></nav></div></header><main><section class="hero"><div class="inner"><div class="hero-copy"><p class="scope-note" style="font-size:.85rem;margin:0 0 10px">Internal candidate · No public distribution license has been assigned to the new material.</p><h1>Hand over a draft.<br>Change the brief. Get it back reviewed.</h1><p>Stay in the lead’s conversation. A producer revises the work, a separate reviewer opens the file, and the lead brings back the same version with the review.</p><div class="actions"><a href="learn/try-review.html#en" class="primary">Review a handoff</a><a href="builder/四端统一建队台.html#en" class="ghost">Build your team</a></div><p class="trialnote">Offline exercise. No account or model required.</p></div><figure class="player"><video controls playsinline preload="none" width="960" height="540" aria-label="Why send back a sheet over one spare kit?" poster="data:image/webp;base64,[[MAS:asset-2]]"><source src="media/demo.en.mp4" type="video/mp4"></video><figcaption><span>Why send back a sheet over one spare kit?</span><span class="medialinks"><a href="media/demo.en.mp4">28-second demo</a> · <a href="media/demo.en.gif">Animated GIF</a></span></figcaption></figure></div></section><section class="strip inner" id="hosts-en"><div class="section-head"><div><h2>Run it on your platform</h2><p>Choose a host with a working model. Start with the three-role preset.</p></div><a href="builder/四端统一建队台.html#en" class="textlink">Customize roles, groups and portraits</a></div><div class="hostlist"><section class="host"><h3>Grok Bot</h3><div><p>Extract the pack. Reuse existing seats and add any missing roles from the cards.</p><details><summary>What was tested here?</summary><p>An existing team revised after an oversight finding, reviewed R2 and returned it in the lead’s original conversation. Custom setup is guided. Whole-team native import remains unverified.</p></details></div><a href="core/adapters/grok/first-order.zip" download class="file">Get the first-order pack</a></section><section class="host"><h3>OpenMausBot</h3><div><p>In OpenMausBot 0.1.148 choose Templates → Import and select core/adapters/openmaus/team.openmaus.json inside the extracted package. Check for an existing department and inspect permissions.</p><details><summary>What was tested here?</summary><p>The first run used three manually created seats. A custom four-seat file passed the 0.1.148 native data layer in isolated storage. A run through a real user’s account UI remains untested. Importing twice can create another department.</p></details></div><a href="core/adapters/openmaus/team.openmaus.json" class="file">View department file</a></section><section class="host"><h3>WorkBuddy</h3><div><p>Prepare the delivery team in My Experts, select a dedicated workspace and give the lead your draft.</p><details><summary>What was tested here?</summary><p>The bundled 0.1.0 starter ran in a previously configured private trio. The private Mac installer targets WorkBuddy 5.9.3 and has no Apple notarization. Example support email addresses in the original are placeholders.</p></details></div><a href="core/adapters/workbuddy/start.html" class="file">Open setup options</a></section><section class="host"><h3>DeepSeek Harness</h3><div><p>Extract the standard ZIP. In the workspace picker select 一人成阵-DSH itself; it contains inputs and the hidden .dsh directory. Select /solo-to-team in a new chat.</p><details><summary>What was tested here?</summary><p>The sibling directory 试用者第二步 contains the change card. Send it after acknowledgment. For custom exports, extract into a new empty folder and select the directory containing team.definition.json. There are local task artifacts from both the standard and custom four-seat configurations.</p></details></div><a href="core/adapters/deepseek/project.zip" download class="file">Get the standard project</a></section></div><p class="ds">Already using DS Bot v0.3.2? In the team builder choose DeepSeek, then DS Bot, to export an offline plan for persistent seats. Review and confirm the actual setup in your existing Main Bot. <a href="builder/四端统一建队台.html#en">Open the team builder</a> This plan follows the public DS Bot v0.3.2 source. It has not been tried in a live DS Bot installation; confirm actual results with the receiving account’s Main Bot.</p><details class="evidence"><summary>Evidence scope</summary><p>Host results come from local observation and retained team artifacts. Platform runtime logs were unavailable. Each host and export has its own evidence. Independent newcomer setup rates have not been measured.</p></details></section><section class="field"><div class="inner"><h2>Send your first order</h2><ol class="steps"><li><h3>Hand over a draft</h3><p>Give the lead the 20-person activity brief. Ask it to identify the version it received.</p><a href="core/brief/01-intake.md">Get the starting brief</a></li><li><h3>Change the brief</h3><p>After the lead acknowledges that version, send the change to 24 people in the same conversation.</p><a href="core/brief/02-change.md">Get the change card</a></li><li><h3>Inspect the return</h3><p>Open the pack and its review. Match the versions, the change and the actual delivery. Use your checkpoint if you move to another conversation.</p><a href="resume/从这里续办.html#en">Open the resume tool</a></li></ol><p class="distinction">Receipt means the file arrived. Acceptance requires the reviewer to open the matching revision and give a finding. A group shares progress; authority to assign and execute stays with its existing owner.</p></div></section><div class="bottom inner" id="real-en"><section class="case-card"><h3>How did “round two” become “table two”?</h3><p>A showcase prepared for GitHub turned a round number in the source sheet into a table number. Follow the two subtitle excerpts, the review and the received file to see how the cross-host handoff corrected it.</p><a href="proof/real-handoff/index.html#en">Inspect the real handoff</a> · <a href="proof/authority/index.html#en">Who can change a quantity?</a></section><section class="more"><h2>Keep going</h2><dl><div><dt><a href="core/examples/maintenance/01-intake.md">Try a maintenance schedule</a></dt><dd>A building closes mid-task. See which bookings and draft notices must change.</dd></div><div><dt><a href="core/skills-original/README.md">The original four skills</a></dt><dd>Use them individually or alongside the team.</dd></div><div><dt><a href="source/README.md">Developer source</a></dt><dd>Inspect this candidate’s source and reproduction entry points.</dd></div></dl></section></div><p class="inner"><a href="core/index.html#en">Frozen core portal</a> · <a href="core/README.en.md">Core guide</a> · <a href="builder/四端统一建队台.html#en">Current unified builder</a></p></main><footer><div class="inner footrow"><span>Solo to Team</span><a href="README.en.md">Text edition</a></div></footer></div><noscript><p><a href="README.en.md" lang="en">English text edition</a></p></noscript><script>
(() => {
  function show() {
    const key=location.hash.slice(1), lang=(key==='en'||key.endsWith('-en'))?'en':'zh';
    document.documentElement.lang=lang==='en'?'en':'zh-CN';
    document.title=lang==='en'?'Solo to Team · The reviewed handoff':'一人成阵 · 项目交付';
    document.querySelectorAll('[data-locale]').forEach(section=>{
      const hide=section.dataset.locale!==lang;
      if(hide) section.querySelectorAll('video').forEach(movie=>movie.pause());
      section.hidden=hide;
    });
    if(key===lang)window.scrollTo(0,0);
  }
  addEventListener('hashchange',show);show();
})();
</script><footer style="text-align:center;padding:12px;font-size:13px">Solo to Team [[MAS:version]] · <a href="SCOPE.md">使用范围 / Scope</a></footer></body></html>