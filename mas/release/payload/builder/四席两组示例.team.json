{"format": "solo-to-team.definition", "version": "1.0.0", "id": "harbor_ops", "name": "Harbor delivery / 港湾交付", "roles": [{"id": "dispatch-a", "name": "统筹 / Coordinator", "responsibility": "按来源派单，交回独审过的文件。", "avatar": null}, {"id": "maker_b", "name": "制作 / Producer", "responsibility": "Create the versioned file.", "avatar": null}, {"id": "checker", "name": "审核 / Reviewer", "responsibility": "Open the actual file in an independent context.", "avatar": null}, {"id": "asset-keeper", "name": "物资接收 / Receiver", "responsibility": "核点领用记录，并向主理人交接。", "avatar": {"mime": "image/png", "data": "data:image/png;base64,"}}], "groups": [{"id": "operations", "name": "行动组", "purpose": "Share the accepted version.", "members": ["dispatch-a", "maker_b", "asset-keeper"]}, {"id": "inventory", "name": "点收组", "purpose": "核对执行包中的交接项。", "members": ["asset-keeper", "checker"]}], "workflow": {"dispatch": "dispatch-a", "produce": "maker_b", "review": "checker", "deliver": "dispatch-a"}}